{
  "name": "denetorus/galaxy-routing",
  "description": "Segment-based routing with lazy adapter instantiation.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.4",
    "denetorus/galaxy-result": "^0.2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "Galaxy\\Routing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Galaxy\\Routing\\Tests\\": "tests/"
    }
  },
  "keywords": [
    "routing",
    "router",
    "galaxy"
  ],
  "archive": {
    "exclude": [
      "/.idea",
      "/AGENTS.md",
      "/vendor",
      "/composer.lock",
      "/.phpunit.cache"
    ]
  }
}
